BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//CalConflict Demo//CN
X-WR-CALNAME:业务方示例日历
X-WR-TIMEZONE:Asia/Shanghai
BEGIN:VTIMEZONE
TZID:Asia/Shanghai
BEGIN:STANDARD
DTSTART:19700101T000000
TZOFFSETFROM:+0800
TZOFFSETTO:+0800
TZNAME:CST
END:STANDARD
END:VTIMEZONE
BEGIN:VEVENT
UID:weekly-staff-meeting@example.com
SUMMARY:全员周会（每周一上午）
DTSTART;TZID=Asia/Shanghai:20260615T090000
DTEND;TZID=Asia/Shanghai:20260615T100000
LOCATION:大会议室
RRULE:FREQ=WEEKLY;BYDAY=MO;UNTIL=20260928T000000Z
ATTENDEE;CN=全体成员:mailto:all@example.com
DESCRIPTION:每周一上午的全员例会\,讨论本周工作重点和上周总结。
END:VEVENT
BEGIN:VEVENT
UID:weekly-tech-review@example.com
SUMMARY:技术方案评审（每周三下午）
DTSTART;TZID=Asia/Shanghai:20260617T140000
DTEND;TZID=Asia/Shanghai:20260617T153000
LOCATION:会议室B
RRULE:FREQ=WEEKLY;BYDAY=WE;COUNT=12
ATTENDEE:mailto:tech-leads@example.com
END:VEVENT
BEGIN:VEVENT
UID:monthly-finance-report@example.com
SUMMARY:月度财报评审（每月最后一个周五）
DTSTART;TZID=Asia/Shanghai:20260626T150000
DTEND;TZID=Asia/Shanghai:20260626T170000
LOCATION:董事会议室
RRULE:FREQ=MONTHLY;BYDAY=FR;BYSETPOS=-1;COUNT=6
ATTENDEE:mailto:cfo@example.com
ATTENDEE:mailto:finance@example.com
ATTENDEE:mailto:ceo@example.com
END:VEVENT
BEGIN:VEVENT
UID:daily-standup@example.com
SUMMARY:每日站会（工作日）
DTSTART;TZID=Asia/Shanghai:20260615T100000
DTEND;TZID=Asia/Shanghai:20260615T101500
LOCATION:线上
RRULE:FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR;UNTIL=20260731T000000Z
EXDATE;TZID=Asia/Shanghai:20260701T100000,20260702T100000
END:VEVENT
BEGIN:VEVENT
UID:monthly-1on1-zhang@example.com
SUMMARY:月度1v1 - 张三
DTSTART;TZID=Asia/Shanghai:20260605T160000
DTEND;TZID=Asia/Shanghai:20260605T163000
LOCATION:会议室A
RRULE:FREQ=MONTHLY;BYMONTHDAY=5;COUNT=6
ATTENDEE:mailto:zhangsan@example.com
ATTENDEE:mailto:manager@example.com
END:VEVENT
END:VCALENDAR
